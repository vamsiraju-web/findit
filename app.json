{
  "expo": {
    "name": "FindIt",
    "slug": "findit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "findit",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E4EAEF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.findit.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FindIt needs microphone access to record voice memos for item logging.",
        "NSCameraUsageDescription": "FindIt needs camera access to photograph storage locations.",
        "NSPhotoLibraryUsageDescription": "FindIt needs photo library access to attach existing photos to items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4F72"
      },
      "package": "com.findit.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FindIt to take photos of storage locations."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow FindIt to record voice memos."
        }
      ],
      "expo-font"
    ]
  }
}
